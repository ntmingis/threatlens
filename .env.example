# Copy to .env and load it in your shell (the app reads plain environment variables).
# Never commit .env.

# --- Threat intelligence (optional). Empty = provider reports NOT_CONFIGURED, never "clean". ---
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Storage and limits ---
THREATLENS_DATA_DIR=./data
THREATLENS_MAX_UPLOAD_MB=20
THREATLENS_SCAN_TIMEOUT_S=120
THREATLENS_WORKER_MEMORY_MB=1024

# --- ClamAV ---
# clamscan (default, tested) or clamdscan (talks to a local clamd over its unix socket; untested in v0.1)
THREATLENS_CLAMAV_MODE=clamscan
# Leave empty to auto-detect the signature database directory
THREATLENS_CLAMAV_DB=
THREATLENS_CLAMAV_TIMEOUT_S=90

# --- Archive / PDF safety limits ---
THREATLENS_ARCHIVE_MAX_ENTRIES=2000
THREATLENS_ARCHIVE_MAX_DEPTH=2
THREATLENS_ARCHIVE_MAX_TOTAL_MB=200
THREATLENS_ARCHIVE_MAX_RATIO=100
THREATLENS_PDF_MAX_PAGES=300

# --- URL scanning ---
# true = resolve the hostname (sends a DNS query for the submitted domain)
THREATLENS_RESOLVE_DNS=false
THREATLENS_VT_MALICIOUS_THRESHOLD=3
THREATLENS_INTEL_CACHE_TTL_S=21600

# --- API ---
# Comma-separated origins allowed to call the API from another site. Empty = same-origin only.
THREATLENS_CORS_ORIGINS=
THREATLENS_RATE_LIMIT_PER_MIN=20
